# Gemini key is read only by the local Node/Vite server.
GEMINI_API_KEY=

# Supabase Project Settings → API. The URL + publishable/anon key are public
# client configuration; the service-role/secret key must stay server-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Exact public origin allowed to call the local API proxy.
APP_ORIGIN=http://127.0.0.1:5173

# Never add SUPABASE_SECRET_KEY or GEMINI_API_KEY to frontend code or a VITE_ variable.
